{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "inbox-mail",
    "main": "worker.js",
    "compatibility_date": "2025-05-01",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true
    },

    // ── Plain-text variables ───────────────────────────────────
    // CORS allow-list — comma-separated list of origins permitted to
    //   POST /send. Add http://localhost:8000 (or whichever local port
    //   you use) here for development.
    // ADMIN_EMAILS — exact match list of admin emails; the Worker only
    //   accepts requests from Firebase ID tokens issued to one of these
    //   accounts. Edit + redeploy to add new admins.
    // FIREBASE_PROJECT_ID — must match the project hosting your Firestore
    //   (the JWT's `aud` claim is checked against this).
    // FROM_EMAIL / FROM_NAME — the visible sender on the email. The
    //   FROM_EMAIL must be a verified sender in your Brevo account
    //   (Senders & IP → add booking@andamanvoyages.in and verify via
    //   the link Brevo emails you).
    "vars": {
        "ALLOWED_ORIGIN":      "https://andamanvoyages.in,http://localhost:8000",
        "ADMIN_EMAILS":        "deb@andamanvoyages.in,admin@admin.com,booking@andamanvoyages.in,cancellation@andamanvoyages.in,info@andamanvoyages.in,enquiries@andamanvoyages.in",
        // ALLOWED_SENDERS — addresses the dashboard's Compose modal can pick as "From".
        // Every entry MUST also be a verified sender in your Brevo account
        // (Brevo dashboard → Senders, Domains & Dedicated IPs → Senders).
        // FROM_EMAIL is the default if Compose doesn't send an explicit `from`.
        "ALLOWED_SENDERS":     "booking@andamanvoyages.in,info@andamanvoyages.in,cancellation@andamanvoyages.in,enquiries@andamanvoyages.in,noreply@andamanvoyages.in",
        "FIREBASE_PROJECT_ID": "andaman-b886d",
        "FROM_EMAIL":          "booking@andamanvoyages.in",
        "FROM_NAME":           "Bharat Transport & Tourism"
    }

    // ── Secrets (set after first deploy) ───────────────────────
    // The Brevo v3 API key. Generate one at https://app.brevo.com/security/api
    // (smtp/email scope is enough). Set with:
    //     npx wrangler secret put BREVO_API_KEY
    //
    // After deployment your Worker URL will be something like
    // https://inbox-mail.<your-subdomain>.workers.dev — paste it into
    // dashboard.html → window.INBOX_WORKER_URL.
}